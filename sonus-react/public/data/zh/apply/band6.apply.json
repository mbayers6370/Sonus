  "units": {
    "b6-grammar": [
      {
        "id": "b6-grammar-apply-001",
        "wordId": "L6-0006",
        "zh": "不过是一个文字游戏罢了。",
        "en": "It's just a play on words.",
        "pinyin": "bu4 shi4 ge4 le5。",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-002",
        "wordId": "L6-0033",
        "zh": "电视上的内容本身很有意义。",
        "en": "The content on TV itself is very meaningful.",
        "pinyin": "de5 ben3 hen3 you3。",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-003",
        "wordId": "L6-0060",
        "zh": "他不再是以前那个他。",
        "en": "He isn't himself anymore.",
        "pinyin": "ta1 bu4 shi4 na4 ge4 ta1。",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-004",
        "wordId": "L6-0106",
        "zh": "他常年在外出差，很少回家。",
        "en": "He travels on business all year round and rarely comes home.",
        "pinyin": "ta1 zai4， hen3 shao3。",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-005",
        "wordId": "L6-0167",
        "zh": "此前我父亲从没出过国。",
        "en": "My father has never been outside the country until now.",
        "pinyin": "ci3 wo3 cong2 mei2。",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-006",
        "wordId": "L6-0168",
        "zh": "此事必有隐情。",
        "en": "There must be something at the back of this matter.",
        "pinyin": "ci3 you3。",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-007",
        "wordId": "L6-0172",
        "zh": "我以前从没见过她。",
        "en": "Never have I seen her before.",
        "pinyin": "wo3 cong2 mei2 ta1。",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-008",
        "wordId": "L6-0176",
        "zh": "他搭错了车。",
        "en": "He took the wrong bus by mistake.",
        "pinyin": "ta1 da1 le5 che1。",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-009",
        "wordId": "L6-0194",
        "zh": "你先去，我待会儿就来。",
        "en": "You go first, I'll come in a moment.",
        "pinyin": "ni3 qu4， wo3 lai2。",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-010",
        "wordId": "L6-0376",
        "zh": "很难说明天的天气将会怎样。",
        "en": "It's hard to predict what the weather will be like tomorrow.",
        "pinyin": "hen3 tian1 de5 tian1 yang4。",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-011",
        "wordId": "L6-0400",
        "zh": "油和水不能混合。",
        "en": "Oil and water don't blend.",
        "pinyin": "he2 bu4 hun4。",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-012",
        "wordId": "L6-0416",
        "zh": "他请求她给予优待。",
        "en": "He asked her to give him preferential treatment.",
        "pinyin": "ta1 ta1。",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-013",
        "wordId": "L6-0425",
        "zh": "你不介意的路上捡东西回来？",
        "en": "Would you mind picking up something on the way back?",
        "pinyin": "ni3 bu4 de5 jian3 lai2？",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-014",
        "wordId": "L6-0450",
        "zh": "不要相信一个你一点都不了解他过去的人。",
        "en": "Don't trust a man whose past you know nothing about.",
        "pinyin": "bu4 ge4 ni3 dou1 bu4 le5 jie3 ta1 qu4 de5 ren2。",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-015",
        "wordId": "L6-0481",
        "zh": "据说山上的天气变化很快。",
        "en": "It is said that the weather on the mountain changes easily.",
        "pinyin": "ju4 de5 tian1 hen3。",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-016",
        "wordId": "L6-0511",
        "zh": "你肯定吗？",
        "en": "Are you sure?",
        "pinyin": "ni3 ken3 ma5？",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-017",
        "wordId": "L6-0521",
        "zh": "Ann是啦啦队队长。",
        "en": "Ann is the cheerleading captain.",
        "pinyin": "A n n shi4 la5 la5 zhang3。",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-018",
        "wordId": "L6-0660",
        "zh": "我亲眼见到了它。",
        "en": "I saw it with my own eyes.",
        "pinyin": "wo3 le5 ta1。",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-019",
        "wordId": "L6-0735",
        "zh": "我时而乐观，时而悲观。",
        "en": "I am by turns an optimist and a pessimist.",
        "pinyin": "wo3，。",
        "fromOriginalExample": true
      },
      {
        "id": "b6-grammar-apply-020",
        "wordId": "L6-0752",
        "zh": "这首歌让我想家了。",
        "en": "The song reminds me of my home.",
        "pinyin": "zhe4 shou3 wo3 le5。",
        "fromOriginalExample": true
      }
    ],

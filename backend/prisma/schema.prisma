generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  email              String?  @db.Text
  displayName        String?  @map("display_name") @db.Text
  targetLanguage     String?  @map("target_language") @db.Text
  timezone           String?  @db.Text
  onboardingComplete Boolean  @default(false) @map("onboarding_complete")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  progress UserProgress?

  @@map("profiles")
}

model LegalDocumentAcceptance {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  documentType      String   @map("document_type") @db.Text
  documentVersion   String   @map("document_version") @db.Text
  acceptanceSource  String   @default("signup") @map("acceptance_source") @db.Text
  ageConfirmed      Boolean  @default(false) @map("age_confirmed")
  acceptedIp        String?  @map("accepted_ip") @db.Text
  acceptedUserAgent String?  @map("accepted_user_agent") @db.Text
  acceptedAt        DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, documentType, documentVersion])
  @@index([userId, acceptedAt])
  @@map("legal_document_acceptances")
}

model UserProgress {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  streak           Int       @default(0)
  lastActiveDate   DateTime? @map("last_active_date") @db.Timestamptz(6)
  currentBandId    String?   @map("current_band_id") @db.Text
  currentUnitId    String?   @map("current_unit_id") @db.Text
  currentLessonIdx Int?      @map("current_lesson_idx")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_progress")
}

model QuizAttempt {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  wordId     String   @map("word_id") @db.Text
  isCorrect  Boolean  @map("is_correct")
  responseMs Int?     @map("response_ms")
  answerText String?  @map("answer_text") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([userId, isCorrect, createdAt])
  @@index([userId, wordId, createdAt])
  @@map("quiz_attempts")
}

model SpeakAttempt {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  wordId         String   @map("word_id") @db.Text
  transcript     String?  @db.Text
  detectedPinyin String?  @map("detected_pinyin") @db.Text
  initialOk      Boolean  @default(false) @map("initial_ok")
  finalOk        Boolean  @default(false) @map("final_ok")
  toneOk         Boolean  @default(false) @map("tone_ok")
  score          Int?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([userId, wordId, createdAt])
  @@index([userId, initialOk, finalOk, toneOk, createdAt])
  @@map("speak_attempts")
}

model WordMemoryState {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  wordId            String    @map("word_id") @db.Text
  quizEase          Float     @default(2.5) @map("quiz_ease")
  quizIntervalDays  Int       @default(1) @map("quiz_interval_days")
  quizDueAt         DateTime  @default(now()) @map("quiz_due_at") @db.Timestamptz(6)
  pronunciationRisk Float     @default(0) @map("pronunciation_risk")
  missedQuizCount   Int       @default(0) @map("missed_quiz_count")
  mispronounceCount Int       @default(0) @map("mispronounce_count")
  lastSeenAt        DateTime? @map("last_seen_at") @db.Timestamptz(6)
  lastCorrectAt     DateTime? @map("last_correct_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, wordId])
  @@index([userId, quizDueAt])
  @@index([userId, pronunciationRisk])
  @@index([userId, missedQuizCount, mispronounceCount, quizDueAt])
  @@index([userId, pronunciationRisk, missedQuizCount, mispronounceCount, quizDueAt])
  @@map("word_memory_state")
}

model ProgressEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  eventType   String   @map("event_type") @db.Text
  streakDelta Int      @default(0) @map("streak_delta")
  payloadJson Json?    @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("progress_events")
}

model LocalAuthCredential {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  email        String   @unique @db.Text
  passwordHash String   @map("password_hash") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("local_auth_credentials")
}

model RefreshSession {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash") @db.Text
  familyId        String    @map("family_id") @db.Uuid
  parentTokenHash String?   @map("parent_token_hash") @db.Text
  replacedByHash  String?   @map("replaced_by_hash") @db.Text
  createdIp       String?   @map("created_ip") @db.Text
  createdUserAgent String?  @map("created_user_agent") @db.Text
  revokedReason   String?   @map("revoked_reason") @db.Text
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([familyId, createdAt])
  @@index([userId, familyId, revokedAt])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Text
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  createdIp   String?   @map("created_ip") @db.Text
  userAgent   String?   @map("user_agent") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model SupportAdminCredential {
  username          String   @id @db.Text
  passwordHash      String   @map("password_hash") @db.Text
  recoveryEmail     String?  @map("recovery_email") @db.Text
  createdByUsername String?  @map("created_by_username") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @map("updated_at") @db.Timestamptz(6)

  @@map("support_admin_credentials")
}

model SupportAdminSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username   String    @db.Text
  tokenHash  String    @unique @map("token_hash") @db.Text
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)

  @@index([username, createdAt])
  @@map("support_admin_sessions")
}

model SupportAdminPasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username  String    @db.Text
  tokenHash String    @unique @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([username, createdAt])
  @@map("support_admin_password_reset_tokens")
}

model AdminAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  actorEmail  String?  @map("actor_email") @db.Text
  action      String   @db.Text
  targetUserId String? @map("target_user_id") @db.Uuid
  reason      String   @db.Text
  result      String   @db.Text
  metadataJson Json?   @map("metadata_json")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("admin_audit_logs")
}

model UserLearningAccessControl {
  userId      String   @id @map("user_id") @db.Uuid
  globalAccess Boolean @default(true) @map("global_access")
  cursorJson  Json?    @map("cursor_json")
  overridesJson Json   @default("{}") @map("overrides_json")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("user_learning_access_controls")
}

model UserLearningAccessAudit {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  actorEmail  String?  @map("actor_email") @db.Text
  changeType  String   @map("change_type") @db.Text
  reason      String   @db.Text
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "idx_user_learning_access_audits_user_created_at")
  @@map("user_learning_access_audits")
}

model SupportNote {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetUserId String  @map("target_user_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  actorEmail  String?  @map("actor_email") @db.Text
  note        String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(6)

  @@index([targetUserId, createdAt])
  @@map("support_notes")
}

model DeletionRequest {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetUserId      String    @map("target_user_id") @db.Uuid
  status            String    @default("open") @db.Text
  requestedByUserId String    @map("requested_by_user_id") @db.Uuid
  requestedByEmail  String?   @map("requested_by_email") @db.Text
  requestReason     String    @map("request_reason") @db.Text
  requestChannel    String?   @map("request_channel") @db.Text
  resolvedByUserId  String?   @map("resolved_by_user_id") @db.Uuid
  resolvedByEmail   String?   @map("resolved_by_email") @db.Text
  resolveReason     String?   @map("resolve_reason") @db.Text
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(6)

  @@index([targetUserId, createdAt])
  @@map("deletion_requests")
}

model AccountSecurityEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetUserId String  @map("target_user_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorEmail  String?  @map("actor_email") @db.Text
  eventType   String   @map("event_type") @db.Text
  detail      String?  @db.Text
  metadataJson Json?   @map("metadata_json")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetUserId, createdAt])
  @@map("account_security_events")
}

model ScheduledAccountDeletion {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetUserId      String    @map("target_user_id") @db.Uuid
  targetEmail       String?   @map("target_email") @db.Text
  targetDisplayName String?   @map("target_display_name") @db.Text
  requestedByUserId String    @map("requested_by_user_id") @db.Uuid
  requestedByEmail  String?   @map("requested_by_email") @db.Text
  reason            String    @db.Text
  holdDays          Int       @map("hold_days")
  scheduledFor      DateTime  @map("scheduled_for") @db.Timestamptz(6)
  status            String    @default("scheduled") @db.Text
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId String?   @map("cancelled_by_user_id") @db.Uuid
  cancelledByEmail  String?   @map("cancelled_by_email") @db.Text
  cancelReason      String?   @map("cancel_reason") @db.Text
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(6)

  @@index([status, scheduledFor])
  @@index([targetUserId, createdAt])
  @@map("scheduled_account_deletions")
}

model DeletionCaseHistory {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetUserId      String   @map("target_user_id") @db.Uuid
  targetEmail       String?  @map("target_email") @db.Text
  targetDisplayName String?  @map("target_display_name") @db.Text
  outcome           String   @db.Text
  requestReason     String   @map("request_reason") @db.Text
  requestChannel    String?  @map("request_channel") @db.Text
  requestCreatedAt  DateTime @map("request_created_at") @db.Timestamptz(6)
  resolvedReason    String   @map("resolved_reason") @db.Text
  resolvedByUserId  String?  @map("resolved_by_user_id") @db.Uuid
  resolvedByEmail   String?  @map("resolved_by_email") @db.Text
  resolvedAt        DateTime @map("resolved_at") @db.Timestamptz(6)
  retentionUntil    DateTime @map("retention_until") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetUserId, resolvedAt])
  @@index([retentionUntil])
  @@map("deletion_case_history")
}

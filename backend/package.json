{
  "name": "sonus-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "dev:watch": "node --watch --import tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "build": "tsc -p tsconfig.json",
    "build:render": "prisma generate && prisma migrate deploy && npm run build",
    "test:core": "node scripts/core-regression.mjs",
    "test:core:local": "node scripts/test-core-local.mjs",
    "test:srs": "node --import tsx src/lib/learningPolicy.test.ts",
    "test:auth-contract": "node --import tsx src/lib/authModeProvider.contract.test.ts",
    "test:security": "node scripts/security-regression.mjs",
    "test:auth-modes": "node scripts/auth-mode-boundary.mjs",
    "seed:test-admin": "node scripts/seed-test-admin.mjs",
    "perf:smoke": "node scripts/perf-smoke.mjs",
    "perf:load": "node scripts/load-check.mjs",
    "perf:load:prod": "LOAD_API_BASE_URL=https://sonuslearning.com node scripts/load-check.mjs",
    "start": "node dist/server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:health": "node scripts/db-health-audit.mjs",
    "db:compact:safe": "node scripts/db-compact-safe.mjs",
    "db:ops:nightly": "node scripts/db-ops-nightly.mjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@prisma/client": "^6.19.2",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pdf-lib": "^1.17.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.4",
    "eslint": "^10.0.1",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "prisma": "^6.19.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.56.0"
  }
}

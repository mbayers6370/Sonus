NODE_ENV="development"
DATABASE_URL="postgresql://sonus:sonus_dev_password@localhost:5432/sonus"
AUTH_MODE="mock"
DEV_USER_ID="00000000-0000-4000-8000-000000000001"
DEV_USER_EMAIL="dev@local.test"

# Required only when AUTH_MODE="supabase"
# SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
# SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
# Required only when AUTH_MODE="local"
# ACCESS_TOKEN_SECRET="replace_with_at_least_32_characters"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_SESSION_TTL_DAYS="30"
RESET_TOKEN_TTL_MINUTES="60"
# Base frontend URL used to build password-reset links.
# RESET_URL_BASE="http://localhost:5173"
# Optional logo shown in reset emails.
# RESET_EMAIL_LOGO_URL="https://sonus-1.onrender.com/branding/logo_name_solo.png"
# Sender shown in outbound reset emails.
RESET_EMAIL_FROM="Sonus Team <no-reply@sonus.app>"
# Optional Resend API key. If omitted, reset links are logged server-side in development.
# RESEND_API_KEY="re_xxxxx"

# Login-throttle (separate from general API rate limiting).
LOGIN_THROTTLE_ENABLED="true"
LOGIN_THROTTLE_THRESHOLD="4"
LOGIN_THROTTLE_BASE_MS="2000"
LOGIN_THROTTLE_MAX_MS="300000"
LOGIN_THROTTLE_RESET_MS="900000"
# Optional: admin token to enable debug endpoint for clearing login throttle buckets.
# Endpoint: POST /v1/auth/debug/reset-login-throttle with header `x-admin-token`.
# LOGIN_THROTTLE_ADMIN_TOKEN="replace_with_a_long_random_token"
# Optional: protect /v1/metrics/learning endpoint with a static read token.
# METRICS_READ_TOKEN="replace_with_a_long_random_token"
# Japanese romaji derivation mode for /v1/ja/romaji/sentence
# auto: try provider, then kuromoji, then local fallback
# provider: require external provider URL
# kuromoji: require local kuromoji derivation
# local: always use local fallback map/kana conversion
JA_ROMAJI_MODE="auto"
# Required when JA_ROMAJI_MODE="provider".
# Use {text} placeholder or query param style supported by your provider.
# Example: JA_ROMAJI_API_URL="https://api.example.com/romaji?text={text}"
# JA_ROMAJI_API_URL=""
# Optional: override seeded QA admin account credentials for `npm run seed:test-admin`.
# TEST_ADMIN_EMAIL="qa-admin-f8n2x7r1@sonus.test"
# TEST_ADMIN_PASSWORD="password1"
PORT="4000"
# Use "false" locally; use "1" (or appropriate hop count) behind a single trusted proxy.
TRUST_PROXY="false"

# Comma-separated list of allowed browser origins in deployed environments.
# Leave empty during local mock-auth development.
CORS_ORIGINS=""

# Fastify max request payload size in bytes (default: 1 MiB).
BODY_LIMIT_BYTES="1048576"

# Lightweight in-memory rate limit for API routes (/v1/*).
# RATE_LIMIT_MODE options: memory | redis | edge
RATE_LIMIT_MODE="memory"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="180"
RATE_LIMIT_FAIL_OPEN="true"

# Required only when RATE_LIMIT_MODE="redis" (Upstash REST API compatible).
# REDIS_REST_URL="https://YOUR_INSTANCE.upstash.io"
# REDIS_REST_TOKEN="YOUR_UPSTASH_REST_TOKEN"

# Slow request warning threshold (ms) for API logs.
SLOW_REQUEST_MS="250"

# Set to "false" to disable API audit log entries.
AUDIT_LOG_ENABLED="true"

# Refresh-token cookie options.
AUTH_COOKIE_NAME="sonus_refresh_token"
# AUTH_COOKIE_DOMAIN=".example.com"
AUTH_COOKIE_SAME_SITE="lax"
# AUTH_COOKIE_SECURE defaults to true in production, false otherwise.
# AUTH_COOKIE_SECURE="true"

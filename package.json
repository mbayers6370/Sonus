{
  "name": "language-app-project",
  "private": true,
  "workspaces": [
    "backend",
    "sonus-react"
  ],
  "scripts": {
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit .githooks/pre-push",
    "dev": "npm run dev:all",
    "dev:frontend": "npm run -w sonus-react dev",
    "dev:backend": "npm run -w sonus-backend dev",
    "dev:all": "bash -lc 'trap \"kill 0\" EXIT; npm run -w sonus-backend dev & npm run -w sonus-react dev & wait'",
    "checklist": "node scripts/regression-checklist.mjs",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm run -w sonus-backend test:core:local",
    "test:frontend": "npm run -w sonus-react test:unit",
    "test:core": "npm run -w sonus-backend test:core",
    "lint": "npm run -w sonus-react lint && npm run -w sonus-backend lint",
    "build": "npm run -w sonus-react build && npm run -w sonus-backend build",
    "characters:generate": "node scripts/generate-character-insights.mjs",
    "band1:normalize": "node scripts/band1-normalize-validate.mjs --fix",
    "band1:validate": "node scripts/band1-normalize-validate.mjs",
    "data:zh:lint": "node scripts/zh-data-pipeline.mjs",
    "data:zh:lint:strict": "node scripts/zh-data-pipeline.mjs --fail-on-warn",
    "data:zh:fix": "node scripts/zh-data-pipeline.mjs --fix --write-review-queue",
    "data:zh:queue": "node scripts/zh-data-pipeline.mjs --write-review-queue",
    "data:zh:refresh-defs": "node scripts/refresh-zh-defs.mjs",
    "tatoeba:fetch": "node scripts/tatoeba-fetch.mjs",
    "tatoeba:candidates": "node scripts/tatoeba-generate-candidates.mjs",
    "tatoeba:apply": "node scripts/tatoeba-apply-candidates.mjs"
  },
  "devDependencies": {
    "hanzi": "^2.1.5",
    "prisma": "^6.19.2"
  }
}
